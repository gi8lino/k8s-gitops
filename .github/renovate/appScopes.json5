      "semanticCommitScope": "plex"
    },
    {
      "description": "App scope: prowlarr",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/media/prowlarr/**"],
      "semanticCommitScope": "prowlarr"
    },
    {
      "description": "App scope: radarr",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/media/radarr/**"],
      "semanticCommitScope": "radarr"
    },
    {
      "description": "App scope: sabnzbd",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/media/sabnzbd/**"],
      "semanticCommitScope": "sabnzbd"
    },
    {
      "description": "App scope: sonarr",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/media/sonarr/**"],
      "semanticCommitScope": "sonarr"
