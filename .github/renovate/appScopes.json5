{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "App scope: whoami",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/debug/whoami/**"],
      "semanticCommitScope": "whoami"
    },
    {
      "description": "App scope: filebrowser",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/filebrowser/**"],
      "semanticCommitScope": "filebrowser"
    },
    {
      "description": "App scope: gitlab",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/gitlab/gitlab-runner/**"],
      "semanticCommitScope": "gitlab"
    },
    {
      "description": "App scope: gitlab",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/gitlab/gitlab/**"],
      "semanticCommitScope": "gitlab"
    },
    {
      "description": "App scope: gitlab",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/gitlab/valkey/**"],
      "semanticCommitScope": "gitlab"
    },
    {
      "description": "App scope: healthchecks",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/healthchecks/**"],
      "semanticCommitScope": "healthchecks"
    },
    {
      "description": "App scope: keycloak",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/keycloak/keycloak/**"],
      "semanticCommitScope": "keycloak"
    },
    {
      "description": "App scope: plex",
      "matchDatasources": ["docker"],
