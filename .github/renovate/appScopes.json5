      "semanticCommitScope": "tautulli"
    },
    {
      "description": "App scope: minio",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/minio/**"],
      "semanticCommitScope": "minio"
    },
    {
      "description": "App scope: motus",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/motus/motus/**"],
      "semanticCommitScope": "motus"
    },
    {
      "description": "App scope: nextcloud",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/nextcloud/nextcloud/**"],
      "semanticCommitScope": "nextcloud"
    },
    {
      "description": "App scope: nextcloud",
      "matchDatasources": ["docker"],
      "matchPaths": ["cluster/apps/nextcloud/valkey/**"],
      "semanticCommitScope": "nextcloud"
    },
    {
      "description": "App scope: renovate",
      "matchDatasources": ["docker"],
