---
apiVersion: v1
kind: Secret
metadata:
  name: kumbuka-oidc
  namespace: kumbuka
type: Opaque
stringData:
  KUMBUKA__OIDC_ISSUER: https://sso.${BASE_DOMAIN}/realms/hq
  KUMBUKA__OIDC_CLIENT_ID:
  KUMBUKA__OIDC_CLIENT_SECRET:
  KUMBUKA__OIDC_SESSION_SECRET: # generate with `openssl rand -base64 32`
  KUMBUKA__OIDC_GROUP_CLAIM: groups
  KUMBUKA__OIDC_ADMIN_GROUP: <ADMIN-GROUP>
---
apiVersion: v1
kind: Secret
metadata:
    name: kumbuka-config
    namespace: kumbuka
type: Opaque
stringData:
    KUMBUKA__ENCRYPTION_KEY: # generate with `openssl rand -base64 32`

