---
apiVersion: v1
kind: Secret
metadata:
    name: keycloak-snitch
    namespace: keycloak
type: Opaque
stringData:
  KC_SPI_EVENTS_LISTENER__SNITCH__WEBHOOK_SECRET: # openssl rand -hex 32
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-warden
  namespace: keycloak
type: Opaque
stringData:
  warden.yaml: |
    rule:
      threshold: 5
      window: 1m
      ban: 15m
    targets:
      receiver:
        enabled: true
        provider: cloudflare
        zone-id: "YOUR_CLOUDFLARE_ZONE_ID"
        secret: "YOUR_CLOUDFLARE_API_TOKEN"

# vi: ft=yaml
