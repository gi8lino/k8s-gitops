---
apiVersion: v1
kind: Secret
metadata:
  name: garage-bootstrap
  namespace: garage-backup
type: Opaque
stringData:
  bootstrap.yaml: |
    users:
      - accessKey: GKEXAMPLEBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: db-backup
    policies:
      - name: db-backup
        buckets:
          - name: db-backups
            read: true
            write: true
    buckets:
      - name: db-backups

