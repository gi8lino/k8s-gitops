---
apiVersion: v1
kind: Secret
metadata:
  name: garage-bootstrap
  namespace: garage-backup
type: Opaque
stringData:
  bootstrap.yaml: |
    users:
      - accessKey: KUMBUKABACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: kumbuka-db-backup
      - accessKey: K8UPBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: k8up-backup
      - accessKey: KEYCLOAKBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: keycloak-db-backup
      - accessKey: NEXTCLOUDBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: nextcloud-db-backup
      - accessKey: MOTUSBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: motus-db-backup
      - accessKey: WIKIBACKUP
        secretKey: REPLACE_WITH_SECRET
        policy: wiki-db-backup
    policies:
      - name: kumbuka-db-backup
        buckets:
          - name: kumbuka-db-backups
            read: true
            write: true
      - name: k8up-backup
        buckets:
          - name: k8up-cluster-resources
            read: true
            write: true
          - name: k8up-dozzle
            read: true
            write: true
          - name: k8up-filebrowser
            read: true
            write: true
          - name: k8up-healthchecks
            read: true
            write: true
          - name: k8up-keycloak
            read: true
            write: true
          - name: k8up-media
            read: true
            write: true
          - name: k8up-nextcloud
            read: true
            write: true
          - name: k8up-wiki
            read: true
            write: true
      - name: keycloak-db-backup
        buckets:
          - name: keycloak-db-backups
            read: true
            write: true
      - name: nextcloud-db-backup
        buckets:
          - name: nextcloud-db-backups
            read: true
            write: true
      - name: motus-db-backup
        buckets:
          - name: motus-db-backups
            read: true
            write: true
      - name: wiki-db-backup
        buckets:
          - name: wiki-db-backups
            read: true
            write: true
    buckets:
      - name: kumbuka-db-backups
      - name: k8up-cluster-resources
      - name: k8up-dozzle
      - name: k8up-filebrowser
      - name: k8up-healthchecks
      - name: k8up-keycloak
      - name: k8up-media
      - name: k8up-nextcloud
      - name: k8up-wiki
      - name: keycloak-db-backups
      - name: nextcloud-db-backups
      - name: motus-db-backups
      - name: wiki-db-backups

# vi: ft=yaml
